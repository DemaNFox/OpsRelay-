# Server
OPSRELAY_SERVER_HOST=0.0.0.0
OPSRELAY_SERVER_PORT=3030
OPSRELAY_ADMIN_TOKEN=replace-with-a-long-random-admin-token
OPSRELAY_LOG_LEVEL=info

# PostgreSQL container, reserved for the persistent repository follow-up.
POSTGRES_DB=opsrelay
POSTGRES_USER=opsrelay
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
OPSRELAY_DATABASE_URL=postgres://opsrelay:replace-with-a-long-random-postgres-password@127.0.0.1:5432/opsrelay

# Admin CLI
OPSRELAY_SERVER_URL=https://opsrelay.example.com
OPSRELAY_SESSION_DIR=.sessions
