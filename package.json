{
  "name": "opsrelay",
  "private": true,
  "version": "0.2.0",
  "description": "Authorized remote administration MVP with server, admin CLI and Go client agent.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter @opsrelay/protocol build && pnpm --filter @opsrelay/server build && pnpm --filter @opsrelay/admin-cli build",
    "typecheck": "pnpm --filter @opsrelay/protocol build && pnpm -r typecheck",
    "test": "pnpm --filter @opsrelay/protocol build && pnpm -r test",
    "dev:server": "pnpm --filter @opsrelay/server dev",
    "dev:cli": "pnpm --filter @opsrelay/admin-cli dev",
    "operator": "node apps/admin-cli/dist/main.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
